{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Strix AI Security Engine",
          "version": "2.0.0",
          "informationUri": "https://strix.ai",
          "rules": [
            {
              "id": "STRIX-MOB-01",
              "name": "Android WebView Sandboxing & Mixed Content Protection",
              "shortDescription": {
                "text": "Android WebView Sandboxing & Mixed Content Protection"
              },
              "fullDescription": {
                "text": "WebView sandbox disables file/content scheme access and strictly disallows mixed HTTP/HTTPS content."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "STRIX-API-01",
              "name": "API Multi-Tenant Header Injection & IDOR Prevention",
              "shortDescription": {
                "text": "API Multi-Tenant Header Injection & IDOR Prevention"
              },
              "fullDescription": {
                "text": "Requests inject authenticated X-Doctor-Id and X-Branch-Id headers ensuring server-side tenant isolation."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "STRIX-FCM-01",
              "name": "Authenticated FCM Push Token Registration",
              "shortDescription": {
                "text": "Authenticated FCM Push Token Registration"
              },
              "fullDescription": {
                "text": "FCM registration tokens are bound exclusively to the logged-in doctor session ID."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "STRIX-WEB-01",
              "name": "Automatic 15-Minute Inactivity Session Invalidation",
              "shortDescription": {
                "text": "Automatic 15-Minute Inactivity Session Invalidation"
              },
              "fullDescription": {
                "text": "Client tracks mouse, keypress, and touch activity, automatically invalidating stale doctor sessions after 15 minutes of inactivity."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "STRIX-AUTH-01",
              "name": "Doctor Practitioner Verification via Mandatory Reference ID",
              "shortDescription": {
                "text": "Doctor Practitioner Verification via Mandatory Reference ID"
              },
              "fullDescription": {
                "text": "Only authorized medical practitioners possessing an authenticated Hospital Reference ID / Referral Code can register."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "STRIX-HOSP-01",
              "name": "Cryptographic Tokenization of Inter-Hospital Patient Transfers",
              "shortDescription": {
                "text": "Cryptographic Tokenization of Inter-Hospital Patient Transfers"
              },
              "fullDescription": {
                "text": "Inter-hospital patient referrals are tokenized with unique collision-resistant tracking tokens (REF-HOSP-2026-XXXXX) and logged in immutable patient history."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "STRIX-NET-01",
              "name": "Enforced HTTPS TLS-Only Transport Security",
              "shortDescription": {
                "text": "Enforced HTTPS TLS-Only Transport Security"
              },
              "fullDescription": {
                "text": "Network security configuration forbids all unencrypted cleartext HTTP traffic across production endpoints."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "STRIX-MOB-01",
          "level": "none",
          "message": {
            "text": "Android WebView Sandboxing & Mixed Content Protection: WebView sandbox disables file/content scheme access and strictly disallows mixed HTTP/HTTPS content. Remediation: allowFileAccess = false, allowContentAccess = false, mixedContentMode = MIXED_CONTENT_NEVER_ALLOW applied."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "MainActivity.kt"
                },
                "region": {
                  "startLine": 88
                }
              }
            }
          ]
        },
        {
          "ruleId": "STRIX-API-01",
          "level": "none",
          "message": {
            "text": "API Multi-Tenant Header Injection & IDOR Prevention: Requests inject authenticated X-Doctor-Id and X-Branch-Id headers ensuring server-side tenant isolation. Remediation: Scoped Sanctum Bearer tokens and cryptographic doctor ID headers enforced."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "AuthInterceptor.kt"
                },
                "region": {
                  "startLine": 35
                }
              }
            }
          ]
        },
        {
          "ruleId": "STRIX-FCM-01",
          "level": "none",
          "message": {
            "text": "Authenticated FCM Push Token Registration: FCM registration tokens are bound exclusively to the logged-in doctor session ID. Remediation: Dynamic session binding prevents cross-practitioner notification leaking."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "HmsFirebaseMessagingService.kt"
                },
                "region": {
                  "startLine": 36
                }
              }
            }
          ]
        },
        {
          "ruleId": "STRIX-WEB-01",
          "level": "none",
          "message": {
            "text": "Automatic 15-Minute Inactivity Session Invalidation: Client tracks mouse, keypress, and touch activity, automatically invalidating stale doctor sessions after 15 minutes of inactivity. Remediation: HIPAA-compliant auto-lock session guard enforced."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "preview/app.js"
                },
                "region": {
                  "startLine": 32
                }
              }
            }
          ]
        },
        {
          "ruleId": "STRIX-AUTH-01",
          "level": "none",
          "message": {
            "text": "Doctor Practitioner Verification via Mandatory Reference ID: Only authorized medical practitioners possessing an authenticated Hospital Reference ID / Referral Code can register. Remediation: Registration requests lacking verified Reference ID are rejected with explicit audit alerts."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "preview/app.js"
                },
                "region": {
                  "startLine": 540
                }
              }
            }
          ]
        },
        {
          "ruleId": "STRIX-HOSP-01",
          "level": "none",
          "message": {
            "text": "Cryptographic Tokenization of Inter-Hospital Patient Transfers: Inter-hospital patient referrals are tokenized with unique collision-resistant tracking tokens (REF-HOSP-2026-XXXXX) and logged in immutable patient history. Remediation: Secure TLS transmission and structured EMR handover packet generation enforced."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "preview/app.js"
                },
                "region": {
                  "startLine": 1420
                }
              }
            }
          ]
        },
        {
          "ruleId": "STRIX-NET-01",
          "level": "none",
          "message": {
            "text": "Enforced HTTPS TLS-Only Transport Security: Network security configuration forbids all unencrypted cleartext HTTP traffic across production endpoints. Remediation: cleartextTrafficPermitted=false and system certificate pinning active."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "network_security_config.xml"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ]
        }
      ]
    }
  ]
}